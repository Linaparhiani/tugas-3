        "type": "object",
        "properties": {
          "namaPengulas": {
            "type": "string",
            "example": "Lina"
          },
          "komentar": {
            "type": "string",
            "example": "Tempat wisata sangat indah dan menarik"
          },
          "nilai": {
            "type": "number",
            "example": 5,
            "minimum": 1,
            "maximum": 5
